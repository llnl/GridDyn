<?xml version="1.0" encoding="utf-8"?>
<griddyn name="test_time_overcurrent_secondary" version="0.0.1">
   <bus name="bus1">
      <type>SLK</type>
      <angle>0</angle>
      <voltage>1.04</voltage>
      <generator name="gen1" dynmodel="typical">
         <P>0.85</P>
      </generator>
   </bus>
   <bus name="bus2">
      <type>PQ</type>
      <load name="load2">
         <P>0.8</P>
         <Q>0.1</Q>
      </load>
   </bus>
