      <name>secondary_time_over_current</name>
      <type>timeovercurrent</type>
      <pickup>1.0</pickup>
      <instantaneous>1.2</instantaneous>
      <instantaneousdelay>0.02</instantaneousdelay>
      <curve>definite_time</curve>
      <delay>0.05</delay>
   </relay>
   <basepower>100</basepower>
   <timestart>0</timestart>
